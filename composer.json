{
  "name": "andrewdevelop/event-sourcing",
  "description": "A minimalist CQRS/ES package for Laravel/Lumen 9+",
  "type": "package",
  "require": {
    "andrewdevelop/hex-contracts": "^2.0",
    "illuminate/container": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "nesbot/carbon": "^2.53|^3.11",
    "php": "^8.1|^8.2|^8.3|^8.4",
    "ramsey/uuid": "^4.0",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "andrewdevelop",
      "email": "andrewdevelop@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Core\\EventSourcing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
